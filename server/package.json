{
  "name": "leeway-mcp",
  "version": "0.4.0",
  "mcpName": "io.github.YOUR_GITHUB/leeway-mcp",
  "description": "Open-source MCP server that gives AI agents a policy-guarded wallet: risk scans, guarded swaps, pre-sign simulation, x402 payments and human approvals via Telegram.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "leeway-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node scripts/sync-site.mjs --check && node ../extension/scripts/sync-core.mjs --check && node test/smoke.js && node test/equities.js && node test/execution.js",
    "sync-site": "node scripts/sync-site.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "test:exec": "node test/execution.js",
    "test:equities": "node test/equities.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "crypto",
    "x402",
    "web3",
    "claude",
    "defi",
    "security",
    "swap",
    "simulation",
    "transaction-simulation",
    "wallet-security",
    "agent-wallet",
    "x402-client",
    "human-in-the-loop",
    "telegram",
    "tokenized-stocks",
    "rwa",
    "xstocks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB/leeway-mcp.git",
    "directory": "server"
  },
  "homepage": "https://github.com/YOUR_GITHUB/leeway-mcp#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "2.57.17",
    "zod": "^4.6.7"
  }
}
