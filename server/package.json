{
  "name": "mandate-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server that gives AI agents safe, policy-guarded access to on-chain value: prices, wallets, risk scans, gas and x402 payment quotes.",
  "type": "module",
  "main": "src/index.js",
  "bin": { "mandate-mcp": "src/index.js" },
  "files": ["src"],
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/smoke.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js"
  },
  "keywords": ["mcp", "model-context-protocol", "ai-agents", "crypto", "x402", "web3", "claude", "defi", "security"],
  "license": "MIT",
  "engines": { "node": ">=18.17" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
